  "cinefuze": {
    "base": "https://tv2play.hu/",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Linux; Android 11) CineFuze",
      "Accept": "*/*"
    },
    "auth": {
      "url": "https://tv2play.hu/api/authenticate",
      "body": {
        "email": "{user}",
        "password": "{password}",
        "stayLoggedIn": true,
        "deviceToken": {
          "token": null,
          "platform": "web"
        }
      },
      "ok": {
        "success": true
      },
      "check": "https://tv2play.hu/api/users/me",
      "flags": {
        "premium": "isPremium"
      },
      "labels": {
        "premium": "prémium"
      },
      "logout": "https://tv2play.hu/api/logout"
    },
    "catalog": {
      "url": "https://tv2-prod.d-saas.com/grrec-tv2-prod-war/JSServlet4?&rn=&cid=&ts={now}&rd=0,TV2_W_CONTENT_LISTING,50,%5B*platform:web;*domain:tv2play;*currentContent:SHOW;*country:HU;*userAge:18;{catalog.filter}*pagingOffset:{skip}%5D,%5Btitle;url;imageUrl;lead;contentType;category;isPremium%5D",
      "searchUrl": "https://tv2-prod.d-saas.com/grrec-tv2-prod-war/JSServlet4?&rn=&cid=&ts={now}&rd=0,TV2_W_SEARCH_RESULT,80,%5B*platform:web;*domain:tv2play;*country:HU;*userAge:18;*pagingOffset:0;*contentType:SHOW;*query:{search}%5D,%5Btitle;url;imageUrl;lead;contentType;category;isPremium%5D",
      "extract": "var data = (\\{.*?\\});",
      "items": "recommendationWrappers.0.recommendation.items",
      "skipIfNot": {
        "premium": {
          "isPremium": "true"
        }
      },
      "meta": {
        "id": "tv2:{url}",
        "name": "{title}",
        "poster": "{imageUrl}",
        "description": "{lead}",
        "releaseInfo": "{category}"
      }
    },
    "catalogs": {
      "movies": {
        "url": "https://tv2play.hu/api/premium/search/{catalog.channel}",
        "each": "ribbonIds.*",
        "pages": "https://tv2play.hu/api/ribbons/{value}/{page}",
        "items": "cards",
        "only": {
          "cardType": "MOVIE"
        },
        "maxPages": 20,
        "meta": {
          "id": "tv2:{slug}",
          "name": "{title}",
          "poster": "{imageUrl}",
          "description": "{lead}"
        }
      }
    },
    "meta": {
      "url": [
        "https://tv2play.hu/api/search/{id|path}",
        "https://tv2play.hu/api/premium/search/{id|path}"
      ],
      "fields": {
        "name": "{pages.0.title}",
        "description": "{pages.0.lead}",
        "poster": "{pages.0.tabs.*.showData.imageUrl}",
        "background": "{pages.0.backgroundImageUrl}",
        "genres": "pages.0.genre.*"
      },
      "videos": {
        "each": "pages.*.tabs.*.ribbonIds.*",
        "head": "https://tv2play.hu/api/ribbons/{value}",
        "prefer": {
          "title": "(?i)teljes ad"
        },
        "pages": "https://tv2play.hu/api/ribbons/{value}/{page}",
        "items": "cards",
        "maxPages": 60,
        "otherPages": 10,
        "video": {
          "id": "tv2:{slug}",
          "title": "{title}",
          "season": "{seriesInfo.seasonNr}",
          "episode": "{seriesInfo.episodeNr}",
          "released": "{availableFrom}",
          "thumbnail": "{imageUrl}"
        }
      }
    },
    "meta_movie": {
      "url": [
        "https://tv2play.hu/api/premium/search/{id|path}",
        "https://tv2play.hu/api/search/{id|path}"
      ],
      "fields": {
        "name": "{title}",
        "description": "{lead}",
        "poster": "{imageUrl}",
        "background": "{imageUrl}"
      }
    },
    "stream": {
      "steps": [
        {
          "url": [
            "https://tv2play.hu/api/search/{id|path}",
            "https://tv2play.hu/api/premium/search/{id|path}"
          ],
          "when": {
            "if": {
              "drmIsRequired": true
            },
            "use": "stream_drm"
          }
        },
        [
          "https://tv2play.hu/api/streaming-url?playerId={playerId}",
          "https://tv2play.hu/api/premium/streaming-url?playerId={playerId}"
        ],
        "{url}"
      ],
      "stream": "{bitrates.hls}"
    },
    "stream_drm": {
      "steps": [
        [
          "https://tv2play.hu/api/premium/streaming-jwt?playerId={playerId}",
          "https://tv2play.hu/api/streaming-jwt?playerId={playerId}"
        ],
        {
          "url": "{url}",
          "post": "{token}",
          "postType": "application/x-www-form-urlencoded"
        }
      ],
      "stream": "{bitrates.dash}",
      "reason": "Ehhez a filmhez nem érkezett DRM-es stream.",
      "drm": {
        "license": "https://widevine.keyos.com/api/v4/getLicense",
        "headers": {
          "customdata": "{drm.data}"
        },
        "field": ""
      }
    }
  }
}
